# Trading — live remains disabled by default
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# LLM
LLM_PROVIDER=mock
MODEL_NAME=mock-analyst
OPENAI_API_BASE=

# Optional cloud providers (not required for tests)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

