# Trading — paper is the supported default. Live execution remains disabled.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# LLM
LLM_PROVIDER=mock
MODEL_NAME=mock-analyst
OPENAI_API_BASE=

# Provider keys (leave empty in git; fill only in local .env outside version control)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Exchange credentials — unused while LIVE_TRADING_ENABLED=false
# Prefer trading-only keys with withdrawals disabled and IP allowlisting where supported.
# Never commit real values. Store outside Git.
COINBASE_API_KEY=
COINBASE_API_SECRET=
DELTA_API_KEY=
DELTA_API_SECRET=

# Market data (public / read-only)
DEFAULT_EXCHANGE_ID=kraken
MARKET_DATA_MAX_AGE_SECONDS=120

# Dashboard (binds to localhost by default)
DASHBOARD_AUTO_OPEN=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050

# Paper
# Presence of a STOP file in the repo root activates the kill switch.
