# Coinbase — unused in Phase 3 (no trading)
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Market data
DEFAULT_EXCHANGE_ID=kraken
MARKET_DATA_MAX_AGE_SECONDS=120
