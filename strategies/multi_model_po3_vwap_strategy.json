{
  "strategy_metadata": {
    "name": "Multi-Model PO3 & VWAP Reclaim Strategy",
    "version": "1.0.0",
    "description": "A multi-model momentum and swing strategy combining Power of Three (PO3) liquidity sweeps, VWAP displacement, order flow delta absorption, and ICT Fair Value Gap (FVG) retests.",
    "author": "Crypto Trading MCP Reference Suite",
    "supported_markets": [
      "Crypto",
      "Futures",
      "Forex",
      "Stocks"
    ],
    "recommended_pairs": [
      "BTCUSDT",
      "ETHUSDT",
      "SOLUSDT",
      "NQ1!",
      "GOLD"
    ],
    "execution_timeframe": "5m",
    "bias_timeframe": "240m"
  },
  "risk_management": {
    "risk_per_trade_percent": 1.0,
    "min_risk_reward_ratio": 2.0,
    "target_risk_reward_ratio": 4.0,
    "stop_loss_method": "Structural_3Bar_Swing",
    "atr_fallback_multiplier": 2.0,
    "partial_take_profit_1r": {
      "enabled": true,
      "exit_quantity_percent": 50
    },
    "move_stop_loss_to_breakeven_at_1r": true,
    "circuit_breakers": {
      "max_daily_loss_percent": 5.0,
      "max_trades_per_day": 10,
      "cooldown_bars_between_trades": 7,
      "eod_flat_close_enabled": true
    }
  },
  "signal_filters": {
    "adx": {
      "length": 11,
      "min_strength": 21
    },
    "ema_alignment": {
      "fast_ema": 9,
      "slow_ema": 21,
      "structural_ema": 50,
      "long_term_ema": 200
    },
    "volume": {
      "length": 20,
      "multiplier": 1.3
    }
  },
  "trading_models": [
    {
      "model_id": "M1",
      "name": "Power of Three (PO3) Sweep & Rejection",
      "type": "Liquidity_Sweep",
      "enabled": true,
      "rules": {
        "sweep_lookback_bars": 10,
        "sweep_margin_percent": 0.5,
        "targets": [
          "PDH",
          "PDL",
          "PMH",
          "PML"
        ],
        "confirmation": "Candle body close rejection beyond swept liquidity level with ADX and EMA stack alignment."
      }
    },
    {
      "model_id": "M2",
      "name": "VWAP Reclaim with Displacement",
      "type": "Trend_Continuation",
      "enabled": true,
      "rules": {
        "vwap_reclaim_lookback": 5,
        "min_body_atr_multiplier": 1.0,
        "volume_multiplier": 1.3,
        "confirmation": "Strong displacement body closing across VWAP aligned with 4H structural trend bias."
      }
    },
    {
      "model_id": "M3",
      "name": "Order Flow Absorption Reversal",
      "type": "Mean_Reversion",
      "enabled": true,
      "rules": {
        "absorption_max_body_atr": 0.2,
        "absorption_min_volume_multiplier": 2.5,
        "cvd_divergence_lookback": 5,
        "confirmation": "High-volume pin bar / absorption wick at S/R or VWAP confirmed by Cumulative Volume Delta (CVD) divergence."
      }
    },
    {
      "model_id": "M4",
      "name": "ICT 4H/15m Fair Value Gap (FVG) Swing Model",
      "type": "Smart_Money_Concepts",
      "enabled": true,
      "rules": {
        "htf_timeframe": "240m",
        "ltf_timeframe": "15m",
        "entry_conditions": [
          "1. 4H swing high/low swept.",
          "2. 15m Market Structure Break (MSB) with candle body close.",
          "3. Formation of 15m Fair Value Gap (FVG).",
          "4. Price retraces to at least 0.5 Fibonacci level into the FVG."
        ],
        "entry_trigger": "Limit order placed inside the 15m FVG at/above 0.5 Fib retracement.",
        "invalidation": "Two consecutive 4H candle closes above/below the HTF swing level."
      }
    }
  ]
}
